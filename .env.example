# 服务端统一提供 DashScope Key（ASR 语音识别 + 通义千问梳理共用）。
# 客户端页面可不填；留空则语音转写不可用、AI 梳理降级为规则清洗。
DASHSCOPE_API_KEY=

# 任务状态存储：配置后走 Redis（多副本共享、自愈并发计数）；
# 留空则降级为内存（仅适合单进程本地开发）。
REDIS_URL=redis://redis:6379/0

# 单 IP 每小时最多提交次数（防刷爆 API 账单）
IP_LIMIT_PER_HOUR=20

# 全服务并行任务数上限（超过返回 429）
GLOBAL_CONCURRENCY=4

# 音频处理长度上限（秒），超长裁剪；也用于上传校验提示
MAX_AUDIO_SEC=7200

# ===== 语音识别(ASR)提速调优 =====
# 并发上限：DashScope 实时 ASR 账号硬上限（实测 20 路），超出被 Throttling.RateQuota 限流。
# 若控制台提额可相应调大；调小则牺牲速度换更稳。
ASR_MAX_CONCURRENCY=20
# 单块下限（秒）：切片粒度。越小→中短视频也能用满 20 路并发；过小→连接数多/单块易失败。
# 默认 10s（原 20s）；配合并发上限，约 200s 以上视频即占满 20 路。
ASR_MIN_CHUNK_SEC=10
# 切片重叠（秒）：相邻块重叠避免句边界截断。越小→重复识别越少越快；过小可能切断词。
# 默认 0.4s（原 1.5s）。
ASR_OVERLAP_SEC=0.4
# 静音切除：去除 >=0.5s 静音压缩有效语音时长（省钱+提速）。1=开 0=关。
ASR_SILENCE_REMOVE=1
